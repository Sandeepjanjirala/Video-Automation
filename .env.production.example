# Copy to .env ONLY for a fresh installation; merge missing entries on existing hosts.
# Never change existing PostgreSQL credentials or the Compose project identity.
POSTGRES_USER=postgres
POSTGRES_DB=studio
POSTGRES_PASSWORD=
POSTGRES_PORT=5433
REDIS_PORT=6379
DJANGO_SECRET_KEY=
STUDIO_PASSWORD=
STUDIO_DOMAIN=studio.sandeepwebsolutions.in
STUDIO_HOST_PORT=8788
# Preserve the existing data/secret_key value as DJANGO_SECRET_KEY on adoption.
# Database passwords in this Compose stack must be URL-safe: letters, digits, _ or -.
# Existing non-URL-safe credentials need a reviewed URL encoding change; do not rotate blindly.
# Optional services: leave blank for offline features. No paid API is used by deployment tests.
STUDIO_ONLINE=0
STUDIO_GEMINI_KEY=
STUDIO_SARVAM_KEY=
STUDIO_PIXABAY_KEY=
STUDIO_PEXELS_KEY=
STUDIO_AZURE_KEY=
STUDIO_AZURE_REGION=
# data/ is always the persistent mount. Container REEL_DATA_DIR is /app/data.
# One Celery render task and one scene at a time are enforced by the production overlay.
# Host-script options are shell environment variables (not .env):
# STUDIO_MIN_DISK_MB=4096 STUDIO_BACKUP_KEEP=7 STUDIO_TEMP_DAYS=7
