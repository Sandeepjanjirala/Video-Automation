# Telugu Reel Studio: copy this file to ".env" (same folder) and fill in your keys.
# ".env" is ignored by Git, so your keys are never pushed to GitHub and "git pull" never changes them.
# Keys set here are used automatically; Settings shows "Set in the .env file" for them.

# Google Gemini (writing Telugu, captions, footage choices): https://aistudio.google.com/apikey
STUDIO_GEMINI_KEY=

# Sarvam AI (Bulbul Telugu voice): https://dashboard.sarvam.ai
STUDIO_SARVAM_KEY=

# Free stock videos: https://pixabay.com/api/docs/  (optional fallback: https://www.pexels.com/api/)
STUDIO_PIXABAY_KEY=
STUDIO_PEXELS_KEY=

# Azure Speech (optional)
STUDIO_AZURE_KEY=

# 1 = online services start switched on when Settings has never been saved
STUDIO_ONLINE=1

# Optional: password for phones and other devices (instead of setting it in Settings).
# Required for Docker, where no browser counts as "this computer".
# STUDIO_PASSWORD=

# Optional: PostgreSQL address when it is not the default local one (postgresql://postgres:postgres@127.0.0.1:5433/studio)
# STUDIO_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/studio
